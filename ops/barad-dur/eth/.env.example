# Copy to `.env` and adjust for your host. `.env` is gitignored.
#
# ETH mainnet data dir. Point at the fastest local disk you have — RocksDB
# I/O patterns saturate slow disks and generate host-wide page-cache
# pressure (which on shared dev hosts can trigger systemd-oomd kills of
# other cgroups, e.g. the GNOME session). ETH mainnet state is large
# (hundreds of GB) — prefer dedicated NVMe with generous free space. On
# barad-dur production this lives on dedicated NVMe under /home/dontpanic/.
# Default fallback in docker-compose.yml points at /chipprbots ZFS which is
# slow — set this override for any host where /chipprbots is HDD-backed.
ETH_DATA_DIR=/etc/fukuii/eth

# Lighthouse (consensus layer) data dir — same disk-speed guidance applies.
LIGHTHOUSE_DATA_DIR=/etc/fukuii/lighthouse-eth
